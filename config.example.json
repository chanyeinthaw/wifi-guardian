{
  "interface": "wlan0",
  "networks": [
    {
      "uuid": "replace-with-primary-profile-uuid",
      "ssid": "home-A"
    },
    {
      "uuid": "replace-with-fallback-profile-uuid",
      "ssid": "home-G"
    }
  ],
  "targets": [
    "1.1.1.1",
    "8.8.8.8"
  ],
  "interval": "10s",
  "failure_samples": 3,
  "packets": 3,
  "max_loss": 0.5,
  "probe_timeout": "2s",
  "connect_timeout": "30s",
  "retry_interval": "60s",
  "wifi_off": "3s",
  "max_resets": 3,
  "stable_for": "3m"
}
